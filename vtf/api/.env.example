# ─── VTF API — Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in real values before running locally.
# For Docker, these are set directly in docker-compose.yml.
# NEVER commit a .env file with real secrets to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=django-insecure-dev-only-change-in-production-use-50-random-chars

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev without Docker — default when DATABASE_URL is not set):
#   Leave DATABASE_URL unset or use: sqlite:////absolute/path/to/db.sqlite3
#
# PostgreSQL (Docker / staging / production):
DATABASE_URL=postgres://vtf:vtf_dev_password@localhost:5432/vtf
#
# PostgreSQL connection pool (optional, prod only):
# CONN_MAX_AGE=60

# ── Redis ─────────────────────────────────────────────────────────────────────
# When set, all caching uses Redis (django-redis).
# When unset, falls back to LocMemCache (dev-only, no persistence).
#
# Local Redis (if running redis-server locally):
REDIS_URL=redis://localhost:6379/0
#
# Docker Redis (automatically set in docker-compose.yml):
# REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# HMAC secret for /go/{token} booking-redirect signing.
# Must be at least 32 random characters in production.
BOOKING_REDIRECT_SECRET=dev-booking-secret-change-in-production

# Salt for IP address hashing (privacy compliance).
SECRET_IP_SALT=dev-ip-salt-change-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Allowed Hosts ─────────────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Fixtures bootstrap ────────────────────────────────────────────────────────
# Set to 0 to skip auto-seeding on docker entrypoint boot.
LOAD_FIXTURES_ON_BOOT=1

# Set to 0 to skip applying catalog fixtures automatically after migrations.
AUTO_LOAD_CATALOG_FIXTURES=1

# ── Optional: Phase 3 scraping ────────────────────────────────────────────────
# GOOGLE_PLACES_API_KEY=your-google-places-key
# ANTHROPIC_API_KEY=your-anthropic-key
# SCRAPER_MONTHLY_CRON=true

# ── Optional: LLM fallback for tariff scraping ────────────────────────────────
# When enabled, a tiny local LLM (via LM Studio) is used as a 3rd-tier fallback
# when both HTTP regex parse and Playwright fail to extract prices.
# Requires LM Studio running locally with a model loaded.
# LLM_FALLBACK_ENABLED=false
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Match the alias passed to llama-server, e.g. `--alias luth-lfm2-350m`.
# LMSTUDIO_MODEL=luth-lfm2-350m
# TRANSLATION_LLM_ENABLED=false
# Translate normal v1 JSON API responses when a supported language is requested
# with ?language=GB, ?lang=GB, X-Language, or Accept-Language.
# TRANSLATION_GLOBAL_RESPONSES_ENABLED=true
# Max JSON chars per LLM call before a section is split into smaller
# batches — keeps calls fast on small/slow local models.
# TRANSLATION_LLM_CHUNK_CHAR_BUDGET=2000
# TRANSLATION_LLM_MAX_TOKENS=12000
# TRANSLATION_LLM_TIMEOUT_SECONDS=300
# TRANSLATION_CACHE_TTL=604800
# LLM_MAX_RETRIES=2

# ── Optional: Discord notifications (shared: cache rebuild + scraper alerts) ──
# Single webhook used by BOTH the cache orchestrator and the scraper.
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# Adds origin metadata to every Discord alert. Allowed values: local, production.
# NOTIFICATION_ENVIRONMENT_NAME=local
# NOTIFICATION_ORIGIN_DOMAIN=localhost
# NOTIFICATION_ORIGIN_IP=127.0.0.1
# CACHE_REBUILD_NOTIFY=false

# ── Optional: Phase 2 recommendation engine ───────────────────────────────────
# Minimum interactions before SVD collaborative filtering activates.
# RECO_MIN_CF_INTERACTIONS=500

# ─────────────────────────────────────────────────────────────────────────────
# Quick-start (local without Docker):
#
#   cp .env.example .env
#   # Edit DATABASE_URL and REDIS_URL as needed
#   source .venv/bin/activate   (or: ./scripts/dev_setup.sh)
#   python manage.py migrate
#   python manage.py load_vtf_mocks
#   python manage.py runserver
#
# Quick-start (Docker):
#
#   docker compose up
#   # API auto-migrates and applies catalog fixtures after migrations
# ─────────────────────────────────────────────────────────────────────────────
